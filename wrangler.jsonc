{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minimalist-web-notepad",
  "account_id": "d7d7c67ac1a53a3b6d365554a6fc4016",
  "main": "src/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-06-04",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "NOTES",
      "id": "fd3d91b7249b45bc9a40ff5e579776df"
    }
  ],
  "vars": {
    "NOTE_MAX_BYTES": "262144",
    "NOTE_TTL_SECONDS": "0",
    "FILE_UPLOAD_HOST": "note.414222.xyz",
    "FILE_DOWNLOAD_HOST": "file.414222.xyz",
    "FILE_MAX_BYTES": "99614720"
  },
  "routes": [
    {
      "pattern": "note.414222.xyz",
      "custom_domain": true
    },
    {
      "pattern": "file.414222.xyz",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "TEMP_FILES",
      "bucket_name": "minimalist-web-notepad-temp-files"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
